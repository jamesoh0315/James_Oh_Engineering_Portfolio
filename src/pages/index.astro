---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectRows from '../components/ProjectRows.astro';
import DeckBanner from '../components/DeckBanner.astro';
import { getSortedProjects } from '../utils/projects';
import { hasOverviewPdf } from '../utils/deck';
import { SITE } from '../consts';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/Portrait/Portrait.jpg';

const projects = await getSortedProjects();

/** Homepage shows the first six in `order`; the archive shows everything. */
const HOMEPAGE_LIMIT = 6;
const highlights = projects.slice(0, HOMEPAGE_LIMIT);
const hasMore = projects.length > HOMEPAGE_LIMIT;
---

<BaseLayout>
	<Hero />

	<div class="mx-auto max-w-[1300px] px-5 sm:px-8 lg:px-12">
		<p class="mb-6 border-l-2 border-signal py-1 pl-4 text-[0.92rem] text-chalk">
			Built with Astro and Tailwind CSS, deployed on Vercel, working alongside
			Claude Code.
		</p>
		{hasOverviewPdf() && <DeckBanner />}
	</div>

	<!-- ── Projects ─────────────────────────────────────────────────────── -->
	<section id="projects" class="mx-auto max-w-[1300px] scroll-mt-20 px-5 py-10 sm:px-8 sm:py-14 lg:px-12">
		<h2 class="h-section mb-6">Projects</h2>

		<ProjectRows projects={highlights} />

		<a
			href="/projects"
			class="mt-7 inline-block border-b border-line pb-[3px] text-[0.94rem] no-underline transition-colors hover:border-signal"
		>
			{hasMore ? `All ${projects.length} projects` : 'Project archive'}
		</a>
	</section>

	<!-- ── About ────────────────────────────────────────────────────────── -->
	<section
		id="about"
		class="mx-auto max-w-[1300px] scroll-mt-20 border-t border-line px-5 py-12 sm:px-8 sm:py-16 lg:px-12"
	>
		<div class="grid gap-9 lg:grid-cols-[1.5fr_1fr] lg:items-center lg:gap-14">
			<div>
				<h2 class="h-section mb-6">About</h2>

				<p class="mb-[1.05rem] max-w-[62ch] text-[1.02rem] leading-[1.68] text-fog">
					Hi, I'm James, a third-year <b class="font-medium text-chalk">Engineering Physics</b> student at the{' '}
					{SITE.school}, specializing in mechanical engineering. Eng Phys is a broad program,
					essentially mechatronics design complemented by honours physics, and mechanical
					engineering is where that breadth has landed me.
				</p>
				<p class="mb-[1.05rem] max-w-[62ch] text-[1.02rem] leading-[1.68] text-fog">
					My passion is <b class="font-medium text-chalk">hands-on design and fabrication</b>,
					shaped by my time on the university's Baja SAE team and academic work with a strong
					focus on robotics. That's taken me through developing automotive components, lean
					manufacturing solutions, and autonomous robots, taking ownership of each one from CAD
					modeling and analysis (FEA, hand calcs in Excel) through physical testing and fabrication.
				</p>
				<p class="max-w-[62ch] text-[1.02rem] leading-[1.68] text-fog">
					I'm currently looking for <b class="font-medium text-chalk">mechanical and
					manufacturing internships</b> where I can contribute to real design work, with plenty
					of time on the shop floor, which is genuinely my favourite part.
				</p>
			</div>

			<figure class="m-0 mx-auto w-full max-w-[19rem] overflow-hidden rounded-lg border border-line bg-surface lg:ml-auto lg:mr-[22%]">
				<Image
					src={portrait}
					alt="James in a UBC Baja hoodie"
					widths={[320, 640]}
					sizes="(min-width: 1024px) 19rem, 65vw"
					class="aspect-square h-full w-full object-cover"
				/>
			</figure>
		</div>
	</section>

	<!-- ── Contact ──────────────────────────────────────────────────────── -->
	<section id="contact" class="scroll-mt-20 border-t border-line bg-surface">
		<div class="mx-auto max-w-[1300px] px-5 py-12 sm:px-8 sm:py-16 lg:px-12">
			<h2 class="h-section">Let's connect!</h2>

			<p class="mt-4 max-w-[50ch] text-[1.02rem] leading-relaxed text-fog">
				Actively looking for mechanical / manufacturing engineering internships, co-ops, and design team work!
			</p>

			<div class="mt-7 flex flex-wrap gap-2.5">
				<a class="btn btn-solid" href={`mailto:${SITE.email}`}>{SITE.email}</a>
				<a
					class="btn btn-ghost inline-flex items-center gap-2"
					href={SITE.linkedin}
					target="_blank"
					rel="noopener noreferrer"
				>
					<LinkedInIcon size={18} />
					LinkedIn
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
