---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectRows from '../components/ProjectRows.astro';
import DeckBanner from '../components/DeckBanner.astro';
import { getSortedProjects } from '../utils/projects';
import { hasDeck } from '../utils/deck';
import { SITE, SKILLS } from '../consts';

const projects = await getSortedProjects();

/** Homepage shows the first six in `order`; the archive shows everything. */
const HOMEPAGE_LIMIT = 6;
const highlights = projects.slice(0, HOMEPAGE_LIMIT);
const hasMore = projects.length > HOMEPAGE_LIMIT;
---

<BaseLayout>
	<Hero />

	<div class="mx-auto max-w-[1300px] px-5 sm:px-8 lg:px-12">
		{hasDeck() && <DeckBanner />}
	</div>

	<!-- ── Projects ─────────────────────────────────────────────────────── -->
	<section id="projects" class="mx-auto max-w-[1300px] scroll-mt-20 px-5 py-10 sm:px-8 sm:py-14 lg:px-12">
		<h2 class="h-section mb-6">Projects</h2>

		<ProjectRows projects={highlights} />

		<a
			href="/projects"
			class="mt-7 inline-block border-b border-line pb-[3px] text-[0.94rem] no-underline transition-colors hover:border-signal"
		>
			{hasMore ? `All ${projects.length} projects` : 'Project archive'}
		</a>
	</section>

	<!-- ── About ────────────────────────────────────────────────────────── -->
	<section
		id="about"
		class="mx-auto max-w-[1300px] scroll-mt-20 border-t border-line px-5 py-12 sm:px-8 sm:py-16 lg:px-12"
	>
		<div class="grid gap-9 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
			<div>
				<h2 class="h-section mb-6">About</h2>

				<p class="mb-[1.05rem] max-w-[62ch] text-[1.02rem] leading-[1.68] text-fog">
					I'm an <b class="font-medium text-chalk">Engineering Physics</b> student at the
					{SITE.school}, working toward a career in mechanical design. Eng Phys is a broad
					program, covering mechanics, electronics, software, and physics, and I've pointed
					that breadth squarely at <b class="font-medium text-chalk">mechanical engineering</b>.
				</p>
				<p class="mb-[1.05rem] max-w-[62ch] text-[1.02rem] leading-[1.68] text-fog">
					What I care about is the loop between analysis and hardware: run the numbers,
					model the part, make it, then find out where the model was wrong. Most of the
					projects here started because something broke, bound, or slipped, and the
					interesting work was figuring out why.
				</p>
				<p class="max-w-[62ch] text-[1.02rem] leading-[1.68] text-fog">
					I'm currently looking for <b class="font-medium text-chalk">mechanical
					engineering internships</b> where I can contribute to real design work: CAD,
					analysis, prototyping, and time on the shop floor.
				</p>
			</div>

			<div>
				<h3 class="mb-3.5 text-[0.95rem] font-semibold">Tools and Skills</h3>
				<ul class="flex flex-wrap gap-1.5">
					{
						SKILLS.map((skill) => (
							<li class="rounded border border-line px-2.5 py-1.5 text-[0.81rem] text-fog">
								{skill}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- ── Contact ──────────────────────────────────────────────────────── -->
	<section id="contact" class="scroll-mt-20 border-t border-line bg-surface">
		<div class="mx-auto max-w-[1300px] px-5 py-12 sm:px-8 sm:py-16 lg:px-12">
			<h2 class="h-section">Let's connect!</h2>

			<p class="mt-4 max-w-[50ch] text-[1.02rem] leading-relaxed text-fog">
				Open to mechanical engineering internships, co-ops, and design team work. The
				fastest way to reach me is email.
			</p>

			<div class="mt-7 flex flex-wrap gap-2.5">
				<a class="btn btn-solid" href={`mailto:${SITE.email}`}>{SITE.email}</a>
				<a
					class="btn btn-ghost"
					href={SITE.linkedin}
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
