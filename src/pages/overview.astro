---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getDeckSlides } from '../utils/deck';

const slides = getDeckSlides();

/**
 * The download button only renders once the PDF actually exists, so it can never
 * 404. Drop the file at public/overview.pdf and it appears on the next build.
 *
 * Resolve from process.cwd() (the project root during `astro build`), NOT from
 * import.meta.url — pages run from a compiled chunk, so a source-relative path
 * silently misses and the button never appears.
 */
const PDF_HREF = '/overview.pdf';
const hasPdf = existsSync(path.join(process.cwd(), 'public', 'overview.pdf'));
---

<BaseLayout
	title="Overview"
	description="A three-minute visual summary of my core mechanical engineering projects."
>
	<section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<SectionHeading index="00" eyebrow="Fast Track" title="Overview" />

			{
				slides.length > 0 && hasPdf && (
					<a
						href={PDF_HREF}
						class="rounded-sm border border-line px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.12em] text-chalk transition-colors hover:border-signal/50 hover:text-signal"
					>
						Download PDF ↓
					</a>
				)
			}
		</div>

		<p class="mt-6 max-w-xl text-base leading-relaxed text-fog">
			The short version — my core projects at a glance, about three minutes to skim.
			{
				slides.length > 0 && (
					<>
						{' '}
						For the full writeups, process, and analysis, head to the{' '}
						<a
							href="/projects"
							class="text-signal underline-offset-4 hover:underline"
						>
							projects
						</a>
						.
					</>
				)
			}
		</p>

		{
			slides.length === 0 ? (
				<div class="mt-12 rounded-md border border-dashed border-line p-10 text-center">
					<p class="font-mono text-xs tracking-[0.1em] text-fog">
						No slides yet — export them to src/assets/deck/
					</p>
					<p class="mt-3 text-sm text-fog/70">
						See <span class="font-mono text-fog">src/assets/deck/README.md</span> for
						the export steps.
					</p>
				</div>
			) : (
				<div class="mt-12 space-y-6">
					{slides.map((slide, i) => (
						<figure class="overflow-hidden rounded-md border border-line bg-surface">
							<Image
								src={slide}
								alt={`Overview slide ${i + 1}`}
								widths={[640, 1024, 1536, 2048]}
								sizes="(min-width: 1024px) 1024px, 100vw"
								loading={i < 2 ? 'eager' : 'lazy'}
								class="h-auto w-full"
							/>
						</figure>
					))}
				</div>
			)
		}

		{
			slides.length > 0 && (
				<div class="mt-14 border-t border-line pt-8">
					<p class="label-mono">Want the detail?</p>
					<a
						href="/projects"
						class="group mt-3 inline-flex items-baseline gap-2 text-lg font-semibold tracking-tight transition-colors hover:text-signal"
					>
						Full project writeups
						<span class="font-mono text-sm text-signal transition-transform group-hover:translate-x-0.5">
							→
						</span>
					</a>
					<p class="mt-2 max-w-lg text-sm leading-relaxed text-fog">
						Design constraints, the analysis behind each decision, and what I'd change
						next time.
					</p>
				</div>
			)
		}
	</section>
</BaseLayout>
