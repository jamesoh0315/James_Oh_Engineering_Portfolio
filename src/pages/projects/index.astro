---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import ProjectDivider from '../../components/ProjectDivider.astro';
import DeckBanner from '../../components/DeckBanner.astro';
import { getSortedProjects } from '../../utils/projects';
import { hasOverviewPdf } from '../../utils/deck';

const projects = await getSortedProjects();

/**
 * Current work reads as full-width rows, the archive as a card grid. The
 * archive is older and there is more of it, so the point there is seeing the
 * whole set at once rather than scrolling a row per project.
 */
const current = projects.filter((project) => !project.data.archived);
const archived = projects.filter((project) => project.data.archived);

/** Hidden until the PDF exists, so it never links to a 404. */
const showDeckBanner = hasOverviewPdf();
---

<BaseLayout
	title="Projects"
	description="Mechanical design and fabrication projects: CAD, analysis, prototyping, and machining."
>
	<section class="mx-auto max-w-[1300px] px-5 py-12 sm:px-8 sm:py-16 lg:px-12">
		<h1 class="h-section">All Projects</h1>

		<p class="mt-4 max-w-[52ch] text-[1.02rem] leading-relaxed text-fog">
			The full set: mechanical design, analysis, and the fabrication that followed.
		</p>

		{showDeckBanner && <DeckBanner class="mt-8" />}

		<div class="mt-4">
			<ProjectRows projects={current} eagerCount={1} />
		</div>

		{
			archived.length > 0 && (
				<Fragment>
					<ProjectDivider
						label="Archive"
						note="Earlier coursework, robotics, and personal builds."
					/>
					<ProjectGrid projects={archived} />
				</Fragment>
			)
		}
	</section>
</BaseLayout>
