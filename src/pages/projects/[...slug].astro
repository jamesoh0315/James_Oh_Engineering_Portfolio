---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getSortedProjects, type Project } from '../../utils/projects';

export async function getStaticPaths() {
	const projects = await getSortedProjects();

	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: {
			project,
			prev: projects[i - 1] ?? null,
			next: projects[i + 1] ?? null,
		},
	}));
}

interface Props {
	project: Project;
	prev: Project | null;
	next: Project | null;
}

const { project, prev, next } = Astro.props;
const { title, summary, tags, coverImage, coverAlt } = project.data;

const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
	<article>
		<!-- ── Header ───────────────────────────────────────────────────── -->
		<header class="border-b border-line">
			<div class="mx-auto max-w-4xl px-6 pb-12 pt-12 sm:pt-16">
				<a
					href="/projects"
					class="inline-flex items-center gap-2 text-[0.9rem] text-fog transition-colors hover:text-signal"
				>
					← All Projects
				</a>

				<h1 class="mt-8 text-[clamp(2.1rem,4.5vw,3.2rem)] font-bold leading-[1.04] tracking-[-0.04em]">
					{title}
				</h1>

				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-fog">{summary}</p>

				{
					tags.length > 0 && (
						<div class="mt-7 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<TagBadge label={tag} emphasis />
							))}
						</div>
					)
				}
			</div>
		</header>

		<!-- Cover shows at its natural aspect ratio — unlike the cards, there's no
		     grid to align to, so nothing gets cropped out of a CAD render. -->
		<div class="mx-auto max-w-5xl px-6 pt-12">
			<figure class="overflow-hidden rounded-lg border border-line bg-surface">
				<Image
					src={coverImage}
					alt={coverAlt || title}
					widths={[640, 1024, 1600]}
					sizes="(min-width: 1024px) 1024px, 100vw"
					loading="eager"
					class="h-auto w-full"
				/>
			</figure>
		</div>

		<!-- ── Body ─────────────────────────────────────────────────────── -->
		<div class="mx-auto max-w-3xl px-6 py-14">
			<div
				class="prose prose-invert prose-engineering max-w-none
					prose-headings:font-semibold prose-headings:tracking-tight
					prose-h2:mt-14 prose-h2:border-t prose-h2:border-line prose-h2:pt-8
					prose-h2:text-2xl prose-h2:scroll-mt-24
					prose-h3:mt-10 prose-h3:text-[1.05rem] prose-h3:font-semibold prose-h3:tracking-[-0.01em]
					prose-h3:text-signal
					prose-p:leading-relaxed
					prose-strong:font-semibold
					prose-li:marker:text-signal/60
					prose-a:underline-offset-4"
			>
				<Content />
			</div>
		</div>

		<!-- ── Prev / next ──────────────────────────────────────────────── -->
		{
			(prev || next) && (
				<nav
					aria-label="More projects"
					class="mx-auto grid max-w-5xl gap-4 px-6 pb-8 sm:grid-cols-2"
				>
					{prev ? (
						<a
							href={`/projects/${prev.id}`}
							class="group rounded-lg border border-line bg-surface p-5 transition-colors hover:border-signal/50"
						>
							<span class="text-[0.8rem] text-fog">← Previous</span>
							<span class="mt-2 block text-sm font-medium transition-colors group-hover:text-signal">
								{prev.data.title}
							</span>
						</a>
					) : (
						<span />
					)}

					{next && (
						<a
							href={`/projects/${next.id}`}
							class="group rounded-lg border border-line bg-surface p-5 transition-colors hover:border-signal/50 sm:text-right"
						>
							<span class="text-[0.8rem] text-fog">Next →</span>
							<span class="mt-2 block text-sm font-medium transition-colors group-hover:text-signal">
								{next.data.title}
							</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>
