---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getSortedProjects, type Project } from '../../utils/projects';
import { formatDateLong } from '../../utils/format';

export async function getStaticPaths() {
	const projects = await getSortedProjects();

	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: {
			project,
			newer: projects[i - 1] ?? null,
			older: projects[i + 1] ?? null,
		},
	}));
}

interface Props {
	project: Project;
	newer: Project | null;
	older: Project | null;
}

const { project, newer, older } = Astro.props;
const { title, date, summary, tags, coverImage, coverAlt } = project.data;

const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
	<article>
		<!-- ── Header ───────────────────────────────────────────────────── -->
		<header class="border-b border-line">
			<div class="mx-auto max-w-4xl px-6 pb-12 pt-12 sm:pt-16">
				<a
					href="/projects"
					class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-fog transition-colors hover:text-signal"
				>
					← All Projects
				</a>

				<time datetime={date.toISOString()} class="label-mono mt-8 block">
					{formatDateLong(date)}
				</time>

				<h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
					{title}
				</h1>

				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-fog">{summary}</p>

				{
					tags.length > 0 && (
						<div class="mt-7 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<TagBadge label={tag} emphasis />
							))}
						</div>
					)
				}
			</div>
		</header>

		<!-- Cover shows at its natural aspect ratio — unlike the cards, there's no
		     grid to align to, so nothing gets cropped out of a CAD render. -->
		<div class="mx-auto max-w-5xl px-6 pt-12">
			<figure class="overflow-hidden rounded-md border border-line bg-surface">
				<Image
					src={coverImage}
					alt={coverAlt || title}
					widths={[640, 1024, 1600]}
					sizes="(min-width: 1024px) 1024px, 100vw"
					loading="eager"
					class="h-auto w-full"
				/>
			</figure>
		</div>

		<!-- ── Body ─────────────────────────────────────────────────────── -->
		<div class="mx-auto max-w-3xl px-6 py-14">
			<div
				class="prose prose-invert prose-engineering max-w-none
					prose-headings:font-semibold prose-headings:tracking-tight
					prose-h2:mt-12 prose-h2:text-xl prose-h2:scroll-mt-24
					prose-p:leading-relaxed
					prose-strong:font-semibold
					prose-li:marker:text-signal/60
					prose-a:underline-offset-4"
			>
				<Content />
			</div>
		</div>

		<!-- ── Prev / next ──────────────────────────────────────────────── -->
		{
			(newer || older) && (
				<nav
					aria-label="More projects"
					class="mx-auto grid max-w-5xl gap-4 px-6 pb-8 sm:grid-cols-2"
				>
					{newer ? (
						<a
							href={`/projects/${newer.id}`}
							class="group rounded-md border border-line bg-surface p-5 transition-colors hover:border-signal/40"
						>
							<span class="label-mono">← Newer</span>
							<span class="mt-2 block text-sm font-medium transition-colors group-hover:text-signal">
								{newer.data.title}
							</span>
						</a>
					) : (
						<span />
					)}

					{older && (
						<a
							href={`/projects/${older.id}`}
							class="group rounded-md border border-line bg-surface p-5 transition-colors hover:border-signal/40 sm:text-right"
						>
							<span class="label-mono">Older →</span>
							<span class="mt-2 block text-sm font-medium transition-colors group-hover:text-signal">
								{older.data.title}
							</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>
