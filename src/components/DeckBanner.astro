---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a
	href="/overview"
	class:list={[
		'group flex items-center gap-3 border-y border-line py-4 text-chalk no-underline transition-colors hover:text-signal',
		className,
	]}
>
	<span class="font-semibold">In a hurry?</span>
	<span class="text-[0.94rem] text-fog">Skim the three-minute overview instead</span>
	<span
		class="ml-auto font-semibold text-signal transition-transform duration-300 ease-out group-hover:translate-x-1.5"
		aria-hidden="true"
	>
		→
	</span>
</a>
