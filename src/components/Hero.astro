---
import { Image } from 'astro:assets';
import { SITE } from '../consts';
import chuck from '../assets/Hybrid/ChuckTest.JPG';
import liner from '../assets/Hybrid/MetalLiner.jpg';

/**
 * Hero previews.
 *
 * The first entry is the main plate; everything after renders as an overlapping
 * inset at its lower left. Adding a preview is another entry here, and the
 * insets stack.
 *
 * The plate is capped and pushed to the right of its column so the insets hang
 * into the gutter between the two columns rather than over the headline.
 */
const previews = [
	{
		src: chuck,
		alt: 'Hybrid liner assembly fit tested at the chuck end of a CNC lathe',
		caption: null,
	},
	{
		src: liner,
		alt: 'The delivered metal spindle liner',
		caption: 'Metal liner as delivered',
	},
];

const [plate, ...insets] = previews;
---

<section class="mx-auto max-w-[1300px] px-5 pb-12 pt-10 sm:px-8 sm:pb-16 sm:pt-14 lg:px-12">
	<div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.85fr] lg:gap-14">
		<div>
			<p class="rise mb-5 inline-flex items-center gap-2.5 text-[0.92rem] text-fog">
				<span class="block h-2 w-2 flex-none bg-signal" aria-hidden="true"></span>
				Seeking Spring / Summer 2027 internships
			</p>

			<h1
				class="rise text-[clamp(3rem,8vw,5.2rem)] font-extrabold leading-[0.95] tracking-[-0.045em] [animation-delay:60ms]"
			>
				{SITE.name}
			</h1>

			<!--
				The width is sized to hold "<role> @ <school>," on one line, and the
				<br> forces the break after it rather than trusting the wrap point.
				Below sm the <br> is off and the whole thing wraps naturally, since
				the school name alone is as much as a narrow phone fits.
			-->
			<p
				class="rise mt-6 max-w-[48ch] text-[clamp(1.1rem,1.75vw,1.4rem)] leading-[1.32] tracking-[-0.02em] [animation-delay:120ms]"
			>
				<a
					href={SITE.roleUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="underline decoration-fog/40 underline-offset-4 transition-colors hover:text-signal hover:decoration-signal"
					>{SITE.role}</a
				> @ <a
					href={SITE.schoolUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="whitespace-nowrap underline decoration-fog/40 underline-offset-4 transition-colors hover:text-signal hover:decoration-signal"
					>{SITE.school}</a
				>,<br class="hidden sm:inline" />{' '}
				specializing in <b class="font-semibold text-signal">{SITE.focus}</b>.
			</p>

			<div class="rise mt-8 flex flex-wrap gap-2.5 [animation-delay:180ms]">
				<a class="btn btn-solid" href="#projects">View projects</a>
				<a class="btn btn-ghost" href="#contact">Get in touch</a>
			</div>
		</div>

		<div class="rise relative mx-auto w-full max-w-[22rem] lg:mx-0 lg:ml-auto lg:max-w-[26rem] [animation-delay:120ms]">
			<figure class="m-0 aspect-[4/3] overflow-hidden rounded-lg bg-surface lg:aspect-[3/4]">
				<Image
					src={plate.src}
					alt={plate.alt}
					widths={[500, 900, 1400]}
					sizes="(min-width: 1024px) 26rem, 90vw"
					loading="eager"
					class="h-full w-full object-cover"
				/>
			</figure>

			{
				insets.length > 0 && (
					<div class="absolute -left-12 bottom-6 hidden w-[9.5rem] space-y-2 lg:block">
						{insets.map((item) => (
							<div class="rounded-lg bg-ink p-1.5">
								<figure class="m-0 aspect-[3/4] overflow-hidden rounded">
									<Image
										src={item.src}
										alt={item.alt}
										widths={[260, 520]}
										sizes="9.5rem"
										loading="eager"
										class="h-full w-full object-cover"
									/>
								</figure>
								{item.caption && (
									<figcaption class="pt-1.5 text-[0.74rem] leading-snug text-fog">
										{item.caption}
									</figcaption>
								)}
							</div>
						))}
					</div>
				)
			}
		</div>
	</div>
</section>
