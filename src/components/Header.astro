---
import { SITE, NAV } from '../consts';
---

<header
	class="sticky top-0 z-40 border-b border-line/70 bg-ink/80 backdrop-blur-md supports-[backdrop-filter]:bg-ink/60"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a
			href="/"
			class="group flex items-baseline gap-2.5 transition-colors hover:text-signal"
		>
			<span class="text-sm font-semibold tracking-tight">{SITE.name}</span>
			<span
				class="hidden font-mono text-[11px] tracking-[0.14em] text-fog transition-colors group-hover:text-signal/70 sm:inline"
			>
				/ ENGPHYS
			</span>
		</a>

		<nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
			{
				NAV.map((item) => (
					<a
						href={item.href}
						class="rounded-sm px-2.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-fog transition-colors hover:text-chalk sm:px-3"
					>
						{item.label}
					</a>
				))
			}
			<a
				href={SITE.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="ml-1 rounded-sm border border-line px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-chalk transition-colors hover:border-signal/50 hover:text-signal"
			>
				LinkedIn
			</a>
		</nav>
	</div>
</header>
