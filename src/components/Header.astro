---
import { SITE, NAV } from '../consts';
import LinkedInIcon from './LinkedInIcon.astro';
---

<header
	class="sticky top-0 z-40 border-b border-line bg-ink/90 backdrop-blur-md supports-[backdrop-filter]:bg-ink/75"
>
	<div class="mx-auto flex h-[68px] max-w-[1300px] items-center justify-between gap-4 px-5 sm:px-8 lg:px-12">
		<a
			href="/"
			class="text-[1.05rem] font-extrabold tracking-[-0.035em] transition-colors hover:text-signal"
		>
			{SITE.name}
		</a>

		<nav aria-label="Primary">
			<ul class="flex items-center gap-4 sm:gap-6">
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								class="text-[0.9rem] text-fog transition-colors hover:text-chalk"
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a
						href={SITE.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn profile"
						title="LinkedIn"
						class="flex items-center rounded-md border border-line px-2.5 py-1.5 text-fog transition-colors hover:border-signal hover:text-signal"
					>
						<LinkedInIcon size={18} />
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
