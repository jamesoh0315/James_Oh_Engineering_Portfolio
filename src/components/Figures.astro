---
import { Image } from 'astro:assets';
import { captionLines } from '../utils/caption';

/**
 * One or more images and/or videos in a row, sharing a single caption.
 *
 * Items are sized by HEIGHT, not width. That's deliberate: shop photos, CAD
 * exports, and phone video arrive at whatever resolution they arrive at, and
 * matching heights keeps a row visually balanced without upscaling the smallest
 * one. Width is capped at the container regardless, so a very wide strip (a 4:1
 * section view, say) shrinks to fit instead of overflowing the prose column —
 * and if the row's combined natural width still exceeds the container, items
 * wrap onto their own line rather than overflow it.
 *
 * `columns` opts out of that: it forces the row into N equal-width columns
 * instead, so items stay side by side at any viewport by shrinking together
 * rather than wrapping. Reach for it when items genuinely belong beside each
 * other regardless of width — e.g. two drawings meant to be compared, where
 * legibility at small size doesn't matter.
 *
 * Images come from src/assets (optimised at build). Videos live in public/ and
 * are referenced by URL, since Astro's image pipeline doesn't process video.
 *
 *   <Figures caption="Print iterations" wide height={180} items={[
 *     { src: printV1, alt: 'First printed prototype' },
 *     { video: '/media/PrintV3.mp4', alt: 'Twist to lock demonstration' },
 *   ]} />
 *
 *   <Figures caption="Drawings" wide columns={2} items={[
 *     { src: drawingA, alt: '...' },
 *     { src: drawingB, alt: '...' },
 *   ]} />
 */

interface ImageItem {
	src: ImageMetadata;
	alt: string;
}

interface VideoItem {
	/** URL under public/, e.g. '/media/clip.mp4'. */
	video: string;
	/** Still frame shown before the clip loads, avoids an empty box. */
	poster?: string;
	alt: string;
}

type Item = ImageItem | VideoItem;

interface Props {
	items: Item[];
	caption?: string;
	/** Max row height in px. Width still caps at the container. Ignored when `columns` is set. */
	height?: number;
	/** Break out past the prose column on large screens, for busy rows. */
	wide?: boolean;
	/** Force N equal-width columns instead of height-based sizing, so items never wrap. */
	columns?: number;
}

const { items, caption, height = 260, wide = false, columns } = Astro.props;

const isVideo = (item: Item): item is VideoItem => 'video' in item;
---

<figure class:list={['not-prose my-10', wide && 'lg:-mx-24 xl:-mx-40']}>
	<div
		class:list={[
			'flex justify-center gap-4',
			columns ? 'flex-nowrap items-stretch' : 'flex-wrap items-end',
		]}
	>
		{
			items.map((item) => (
				<div
					class:list={[
						'overflow-hidden rounded-lg border border-line bg-surface p-1.5',
						columns ? 'flex min-w-0 flex-1 basis-0 items-center justify-center' : 'max-w-full',
					]}
				>
					{isVideo(item) ? (
						<video
							src={item.video}
							poster={item.poster}
							controls
							autoplay
							muted
							loop
							playsinline
							aria-label={item.alt}
							class:list={['rounded', columns ? 'h-auto w-full' : 'h-auto w-auto max-w-full']}
							style={columns ? undefined : `max-height: ${height}px;`}
						/>
					) : (
						<Image
							src={item.src}
							alt={item.alt}
							loading="lazy"
							class:list={[
								'rounded object-contain',
								columns ? 'h-auto w-full' : 'h-auto w-auto max-w-full',
							]}
							style={columns ? undefined : `max-height: ${height}px;`}
						/>
					)}
				</div>
			))
		}
	</div>

	{
		caption && (
			<figcaption class="mx-auto mt-4 max-w-2xl text-center text-[0.9rem] leading-relaxed text-fog">
				{captionLines(caption).map((line, i) => (
					<Fragment>
						{i > 0 && <br />}
						{line}
					</Fragment>
				))}
			</figcaption>
		)
	}
</figure>
