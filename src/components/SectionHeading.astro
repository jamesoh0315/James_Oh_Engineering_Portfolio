---
interface Props {
	/** Two-digit index, e.g. "01". */
	index: string;
	eyebrow: string;
	title: string;
	id?: string;
}

const { index, eyebrow, title, id } = Astro.props;
---

<div id={id} class="scroll-mt-24">
	<div class="flex items-center gap-3">
		<span class="font-mono text-[11px] tracking-[0.14em] text-signal">{index}</span>
		<span class="h-px w-8 bg-line" aria-hidden="true"></span>
		<span class="label-mono">{eyebrow}</span>
	</div>
	<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
</div>
