---
import { Image } from 'astro:assets';
import type { Project } from '../utils/projects';
import TagBadge from './TagBadge.astro';

/**
 * One project as a full-width row: image on one side, title and summary on the
 * other. Rows alternate their image side automatically via :nth-of-type in the
 * parent, so the caller does not track parity.
 */
interface Props {
	project: Project;
	/** Skip lazy-loading for rows above the fold. */
	eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, summary, tags, coverImage, coverAlt, coverPosition } = project.data;

const MAX_TAGS = 4;
const visible = tags.slice(0, MAX_TAGS);
const overflow = tags.length - visible.length;
---

<a
	href={`/projects/${project.id}`}
	class="project-row group grid items-center gap-6 border-b border-line py-8 sm:py-10 lg:grid-cols-[1.2fr_1fr] lg:gap-14"
>
	<figure class="m-0 aspect-[16/10] overflow-hidden rounded-lg bg-surface">
		<Image
			src={coverImage}
			alt={coverAlt || title}
			widths={[600, 1100, 1600]}
			sizes="(min-width: 1024px) 55vw, 100vw"
			loading={eager ? 'eager' : 'lazy'}
			style={`object-position: ${coverPosition};`}
			class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
		/>
	</figure>

	<div>
		<h3
			class="text-[clamp(1.4rem,2.6vw,2rem)] font-bold leading-[1.06] tracking-[-0.035em] transition-colors group-hover:text-signal"
		>
			{title}
		</h3>

		<p class="mt-3 max-w-[46ch] text-base leading-relaxed text-fog">{summary}</p>

		{
			visible.length > 0 && (
				<div class="mt-4 flex flex-wrap gap-1.5">
					{visible.map((tag) => (
						<TagBadge label={tag} />
					))}
					{overflow > 0 && <TagBadge label={`+${overflow}`} />}
				</div>
			)
		}
	</div>
</a>

<style>
	/* Alternate which side the image sits on. */
	@media (min-width: 1024px) {
		.project-row:nth-of-type(even) figure {
			order: 2;
		}
	}
</style>
