---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../utils/projects';

interface Props {
	projects: Project[];
	/** Number of leading cards to load eagerly (above the fold). */
	eagerCount?: number;
}

const { projects, eagerCount = 3 } = Astro.props;
---

{
	projects.length === 0 ? (
		<p class="rounded-md border border-dashed border-line p-10 text-center font-mono text-xs tracking-[0.1em] text-fog">
			No projects yet — add a markdown file to src/content/projects/
		</p>
	) : (
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{projects.map((project, i) => (
				<ProjectCard project={project} eager={i < eagerCount} />
			))}
		</div>
	)
}
