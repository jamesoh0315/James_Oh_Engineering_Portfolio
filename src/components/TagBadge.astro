---
interface Props {
	label: string;
	/** Slightly stronger treatment for detail pages. */
	emphasis?: boolean;
}

const { label, emphasis = false } = Astro.props;
---

<span
	class:list={[
		'inline-flex items-center rounded-sm border px-2 py-1 font-mono text-[10px] uppercase leading-none tracking-[0.1em] whitespace-nowrap',
		emphasis
			? 'border-signal/30 bg-signal/5 text-signal'
			: 'border-line bg-ink/40 text-fog',
	]}
>
	{label}
</span>
