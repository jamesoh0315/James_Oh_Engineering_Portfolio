---
interface Props {
	label: string;
	/** Stronger treatment for project detail headers. */
	emphasis?: boolean;
}

const { label, emphasis = false } = Astro.props;
---

<span
	class:list={[
		'inline-flex items-center whitespace-nowrap rounded border px-2 py-1 text-[0.75rem] leading-none',
		emphasis ? 'border-signal/40 bg-signal/10 text-signal' : 'border-line text-fog',
	]}
>
	{label}
</span>
