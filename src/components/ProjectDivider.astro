---
/**
 * A labelled break between two groups of projects.
 *
 * Deliberately louder than the hairline each project row already carries at its
 * foot: that rule separates one project from the next, this one separates one
 * era of work from another, and the two must not read as the same gesture. The
 * heading-scale label, the amber marker, and the generous space above do that
 * work.
 *
 *   <ProjectDivider label="Archive" note="Earlier coursework and personal builds." />
 */

interface Props {
	label: string;
	/** Optional line beneath the label, for context the label alone can't carry. */
	note?: string;
}

const { label, note } = Astro.props;
---

<div class="pb-8 pt-16 sm:pt-20">
	<div class="flex items-center gap-4">
		<span class="block h-7 w-1.5 flex-none rounded-sm bg-signal sm:h-8" aria-hidden="true"></span>
		<h2
			class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold leading-none tracking-[-0.035em] text-signal"
		>
			{label}
		</h2>
		<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
	</div>

	{
		note && (
			<p class="mt-3.5 max-w-[52ch] pl-[1.625rem] text-[0.97rem] leading-relaxed text-fog">
				{note}
			</p>
		)
	}
</div>
